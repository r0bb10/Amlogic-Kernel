# Keep the kernel version separate from the distribution package and module tree.
CONFIG_LOCALVERSION="-sm1"
# CONFIG_LOCALVERSION_AUTO is not set

# Preserve a general-purpose Debian kernel rather than a hardware-only image.
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_MODULE_UNLOAD=y
CONFIG_TTY=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_IPV6=y
CONFIG_AUDIT=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_SECCOMP=y
CONFIG_INOTIFY_USER=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CPUSETS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_SWAP=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_DM=m
CONFIG_MD=y
CONFIG_DM_CRYPT=m
CONFIG_CRYPTO_USER_API=y
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_NFS_FS=m
CONFIG_CIFS=m
CONFIG_FUSE_FS=m
CONFIG_VETH=m
CONFIG_BRIDGE=y
CONFIG_VLAN_8021Q=m
CONFIG_TUN=m
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=m
CONFIG_NFT_CT=m
CONFIG_NFT_COUNTER=m
CONFIG_NF_CONNTRACK=m
CONFIG_NF_NAT=m
CONFIG_BRIDGE_NETFILTER=m
CONFIG_CAN=m
CONFIG_CAN_RAW=m
CONFIG_USB_STORAGE=y
CONFIG_USB_ACM=m
CONFIG_USB_SERIAL=m
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_HID_GENERIC=y
CONFIG_INPUT_EVDEV=y
CONFIG_SND_USB_AUDIO=m
CONFIG_COMPAT=y
# Enable the generic ARM64 and device-tree facilities before selecting SM1.
CONFIG_MODULES=y
CONFIG_BLOCK=y
CONFIG_OF=y
CONFIG_OF_FLATTREE=y
CONFIG_OF_ADDRESS=y
CONFIG_OF_IRQ=y

# Boot from the X96 Max Plus eMMC with a Debian initramfs.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_EXT4_FS=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_MESON_GX=y
CONFIG_MMC_MESON_MX_SDIO=y

# Serial is the recovery console. Do not make a graphical console a boot dependency.
CONFIG_SERIAL_MESON=y
CONFIG_SERIAL_MESON_CONSOLE=y

# X96 Max Plus platform and wired networking.
CONFIG_ARCH_MESON=y
CONFIG_MESON_GX_SOCINFO=y
CONFIG_MESON_EE_PM_DOMAINS=y
CONFIG_MESON_SECURE_PM_DOMAINS=y
CONFIG_COMMON_CLK_MESON_REGMAP=y
CONFIG_RESET_MESON=y
CONFIG_PINCTRL_MESON=y
CONFIG_PINCTRL_MESON_G12A=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_PWM=y
CONFIG_PWM=y
CONFIG_PWM_MESON=y
CONFIG_I2C_MESON=y
CONFIG_STMMAC_ETH=y
CONFIG_DWMAC_MESON=y
CONFIG_REALTEK_PHY=y
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_INET=y
CONFIG_PM=y
CONFIG_CPU_FREQ=y
CONFIG_CPUFREQ_DT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_IDLE=y
CONFIG_THERMAL=y
CONFIG_CPU_THERMAL=y
CONFIG_CMA=y
CONFIG_WATCHDOG=y
CONFIG_MESON_GXBB_WATCHDOG=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_MESON_VRTC=m
CONFIG_NVMEM_MESON_EFUSE=y

# USB host controllers and PHYs used by the box.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_HOST=y
CONFIG_USB_DWC3_MESON_G12A=y
CONFIG_PHY_MESON_G12A_USB2=y
CONFIG_PHY_MESON_G12A_USB3_PCIE=y

# Onboard QCA6174 over SDIO. Firmware and board data remain userspace files.
CONFIG_WLAN=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH10K=m
CONFIG_ATH10K_SDIO=m

# Upstream Meson HDMI display and the X96 Max+'s HDMI audio topology.
CONFIG_DRM=y
CONFIG_DRM_MESON=m
CONFIG_DRM_MESON_DW_HDMI=m
CONFIG_DRM_PANFROST=m
CONFIG_DRM_FBDEV_EMULATION=y

# Meson video engines and HDMI CEC without unrelated camera or tuner support.
CONFIG_STAGING=y
CONFIG_STAGING_MEDIA=y
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_VIDEO_DEV=m
CONFIG_V4L_MEM2MEM_DRIVERS=y
CONFIG_VIDEO_MESON_VDEC=m
CONFIG_VIDEO_MESON_GE2D=m
CONFIG_MEDIA_CEC_SUPPORT=y
CONFIG_CEC_MESON_G12A_AO=m

CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_MESON_AXG_SOUND_CARD=m
CONFIG_SND_MESON_AXG_FRDDR=m
CONFIG_SND_MESON_AXG_TDMOUT=m
CONFIG_SND_MESON_G12A_TOHDMITX=m
CONFIG_SND_SOC_HDMI_CODEC=m

# Map the actual X96 Max+ remote after boot.
CONFIG_INPUT=y
CONFIG_RC_CORE=m
CONFIG_RC_MAP=m
CONFIG_RC_DECODERS=y
CONFIG_RC_DEVICES=y
CONFIG_IR_MESON=m
CONFIG_IR_NEC_DECODER=m
CONFIG_IR_RC5_DECODER=m
CONFIG_IR_RC6_DECODER=m
CONFIG_IR_JVC_DECODER=m
CONFIG_IR_SONY_DECODER=m
