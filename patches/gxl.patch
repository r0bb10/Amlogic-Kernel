From: Amlogic Kernel Build <41898282+github-actions[bot]@users.noreply.github.com>
Subject: [PATCH] arm64: retain the legacy Amlogic Image load offset for GXL

Legacy Amlogic U-Boot needs a nonzero Image text offset. Match the
0x01080000 offset in the working Ophub S905W kernel rather than allowing
the loader to place an upstream zero-offset Image at the start of RAM.

Adapted from uniqfreq's "Apply TEXT_OFFSET patch for legacy amlogic uboot":
https://github.com/ophub/kernel/blob/main/kernel-patch/beta/deprecated-patches/6.18.y-101-arm64-add-text_offset.patch

Apply only to the GXL target. Keep upstream's boot alignment diagnostic;
the original workaround also suppressed that warning.

---
diff --git a/arch/arm64/kernel/head.S b/arch/arm64/kernel/head.S
--- a/arch/arm64/kernel/head.S
+++ b/arch/arm64/kernel/head.S
@@ -60,7 +60,7 @@
 	 */
 	efi_signature_nop			// special NOP to identity as PE/COFF executable
 	b	primary_entry			// branch to kernel start, magic
-	.quad	0				// Image load offset from start of RAM, little-endian
+	le64sym	_kernel_offset_le		// Image load offset from start of RAM, little-endian
 	le64sym	_kernel_size_le			// Effective size of kernel image, little-endian
 	le64sym	_kernel_flags_le		// Informative flags, little-endian
 	.quad	0				// reserved
diff --git a/arch/arm64/kernel/image.h b/arch/arm64/kernel/image.h
--- a/arch/arm64/kernel/image.h
+++ b/arch/arm64/kernel/image.h
@@ -60,8 +60,10 @@
  * regardless of the endianness of the kernel. While constant values could be
  * endian swapped in head.S, all are done here for consistency.
  */
+#define TEXT_OFFSET 0x01080000
 #define HEAD_SYMBOLS						\
 	DEFINE_IMAGE_LE64(_kernel_size_le, _end - _text);	\
+	DEFINE_IMAGE_LE64(_kernel_offset_le, TEXT_OFFSET);	\
 	DEFINE_IMAGE_LE64(_kernel_flags_le, __HEAD_FLAGS);
 
 #endif /* __ARM64_KERNEL_IMAGE_H */
